# Nginx — reverse proxy snippets for OBELIX subdomains
# Include inside http {} or as separate site files under /etc/nginx/sites-available/

# --- Agency (Mohamed) ---
server {
    listen 80;
    server_name agency.example.com;

    location / {
        proxy_pass http://127.0.0.1:43121;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# --- Client package example ---
server {
    listen 80;
    server_name client.example.com;

    client_max_body_size 10M;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
